ANSI_RE = re.compile(
    r"\x1b\[[0-9;?]*[ -/]*[@-~]"          # CSI sequences (SGR, cursor, ...)
    r"|\x1b\][^\x07]*(?:\x07|\x1b\\)"      # OSC (terminal title, hyperlink)
    r"|\x1b[P-Z^_].*?(?:\x1b\\|$)"         # other escapes (DCS/APC/...)
    r"|\x1b[()][0-9A-B]"                   # charset selection
    r"|\x1b"                               # stray ESC
)

FONT_CANDIDATES = [
    "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
    "/usr/share/fonts/truetype/noto/NotoSansMono-Regular.ttf",
]


def strip_ansi(text):
    return ANSI_RE.sub("", text)


