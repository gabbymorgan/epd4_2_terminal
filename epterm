    ecodes.KEY_KPASTERISK: "*", ecodes.KEY_KPMINUS: "-", ecodes.KEY_KPPLUS: "+",
}

KEY_SHIFT = {
    ecodes.KEY_GRAVE: "~", ecodes.KEY_1: "!", ecodes.KEY_2: "@",
    ecodes.KEY_3: "#", ecodes.KEY_4: "$", ecodes.KEY_5: "%",
    ecodes.KEY_6: "^", ecodes.KEY_7: "&", ecodes.KEY_8: "*",
    ecodes.KEY_9: "(", ecodes.KEY_0: ")",
    ecodes.KEY_MINUS: "_", ecodes.KEY_EQUAL: "+",
    ecodes.KEY_LEFTBRACE: "{", ecodes.KEY_RIGHTBRACE: "}",
    ecodes.KEY_SEMICOLON: ":", ecodes.KEY_APOSTROPHE: '"',
    ecodes.KEY_BACKSLASH: "|",
    ecodes.KEY_COMMA: "<", ecodes.KEY_DOT: ">", ecodes.KEY_SLASH: "?",
}

KEY_SPECIAL = {
    ecodes.KEY_UP: "\x1b[A", ecodes.KEY_DOWN: "\x1b[B",
    ecodes.KEY_RIGHT: "\x1b[C", ecodes.KEY_LEFT: "\x1b[D",
    ecodes.KEY_HOME: "\x1b[H", ecodes.KEY_END: "\x1b[F",
    ecodes.KEY_PAGEUP: "\x1b[5~", ecodes.KEY_PAGEDOWN: "\x1b[6~",
    ecodes.KEY_DELETE: "\x1b[3~", ecodes.KEY_INSERT: "\x1b[2~",
    ecodes.KEY_F1: "\x1bOP", ecodes.KEY_F2: "\x1bOQ",
    ecodes.KEY_F3: "\x1bOR", ecodes.KEY_F4: "\x1bOS",
}

MOD_SHIFT = {ecodes.KEY_LEFTSHIFT, ecodes.KEY_RIGHTSHIFT}
MOD_CTRL = {ecodes.KEY_LEFTCTRL, ecodes.KEY_RIGHTCTRL}
MOD_ALT = {ecodes.KEY_LEFTALT, ecodes.KEY_RIGHTALT}
MOD_CAPS = ecodes.KEY_CAPSLOCK


class Keyboard:
    def __init__(self, on_input, device=None, grab=False):
        self.on_input = on_input
        self.device = device
        self.grab = grab
        self.shift = False
        self.ctrl = False
        self.alt = False
        self.caps = False

    def _find_device(self):
        best = None
        for path in sorted(glob.glob("/dev/input/event*")):
            try:
                dev = evdev.InputDevice(path)
            except OSError:
                continue
            try:
                if ecodes.INPUT_PROP_POINTER in dev.input_props():
                    continue
                keys = dev.capabilities(verbose=False).get(ecodes.EV_KEY, [])
                if {ecodes.KEY_Q, ecodes.KEY_A, ecodes.KEY_Z}.issubset(keys):
                    score = 0 if "keyboard" in dev.name.lower() else 1
                    if best is None or score < best[0]:
                        best = (score, path)
            finally:
                dev.close()
        return best[1] if best else None

    def run(self):
        path = self.device or self._find_device()
        if not path:
            logging.error("no keyboard found "
                          "(specify one with --shell /dev/input/eventN)")
            return
        try:
            dev = evdev.InputDevice(path)
        except OSError as exc:
            logging.error("cannot open %s: %s", path, exc)
            return
        if self.grab:
            try:
                dev.grab()
            except OSError as exc:
                logging.warning("grab failed: %s", exc)
        logging.info("keyboard: %s (%s)", dev.name, path)
        try:
            for ev in dev.read_loop():
                if ev.type != ecodes.EV_KEY:
                    continue
                if ev.value == 0:
                    self._mod(ev.code, False)
                    continue
                if ev.value != 1:
                    continue
                seq = self._translate(ev.code)
                if seq:
                    self.on_input(seq)
        except OSError as exc:
            logging.warning("keyboard read failed: %s", exc)
        finally:
            dev.close()

    def _mod(self, code, down):
        if code in MOD_SHIFT:
            self.shift = down
        elif code in MOD_CTRL:
            self.ctrl = down
        elif code in MOD_ALT:
            self.alt = down
        elif code == MOD_CAPS and down:
            self.caps = not self.caps

    def _translate(self, code):
        if code in MOD_SHIFT or code in MOD_CTRL or code in MOD_ALT:
            self._mod(code, True)
            return None
        if code == MOD_CAPS:
            self._mod(code, True)
            return None
        if code in KEY_SPECIAL:
            return KEY_SPECIAL[code]
        base = KEY_BASE.get(code)
        if base is None:
            return None
        if code in (ecodes.KEY_BACKSPACE, ecodes.KEY_TAB, ecodes.KEY_ENTER,
                    ecodes.KEY_KPENTER, ecodes.KEY_ESC, ecodes.KEY_SPACE):
            ch = base
        elif self.ctrl and len(base) == 1 and "a" <= base <= "z":
            ch = chr(ord(base) - 96)
        elif self.ctrl and base == "\\":
            ch = "\x1c"
        elif self.ctrl and base == "[":
            ch = "\x1b"
        else:
            ch = KEY_SHIFT.get(code, base) if self.shift else base
            if self.shift and "a" <= ch <= "z":
                ch = ch.upper()
        if self.alt:
            ch = "\x1b" + ch
        return ch


# ------------------------------------------------------------------ display
class EPaperTerm:
    def __init__(self, size=12, rows=None, cols=None, interval=1.0,
                 full_every=5, idle_timeout=60.0, margin=8, footer=True,
                 exec_cmd=None, full_clear=False):
        self.epd = epd4in2_V2.EPD()
        self.interval = interval
        self.full_every = full_every
        self.full_clear = full_clear
        self.idle_timeout = idle_timeout
        self.margin = margin
        self.footer = footer
        self.exec_cmd = exec_cmd

        self.font = self._load_font(size)
        self.ascent, self.descent = self.font.getmetrics()
        self.line_h = self.ascent + self.descent + 2
        self.advance = max(1, int(round(self.font.getlength("M"))))
        self.cols = cols or max(1, (self.epd.width - 2 * margin) // self.advance)
        avail_h = self.epd.height - 2 * margin - (self.line_h if footer else 0)
        self.rows = rows or max(1, avail_h // self.line_h)

        self.lines = deque(maxlen=self.rows * 2)
        self.lock = threading.Lock()
        self.dirty = False
        self.stop = threading.Event()
        self.last_input = 0.0

        self.partial_count = full_every  # first frame is a full refresh
        self.initialized = False
        self.last_buf = None             # last buffer written to the panel
        self.full_threshold = 0.15       # force full refresh if >15% pixels change

        self.vterm_screen = None
        self.vterm_stream = None
        self.shell_master = None
        self.shell_proc = None

        logging.info("panel %dx%d, font %dpx -> %d cols x %d rows",
                     self.epd.width, self.epd.height, size,
                     self.cols, self.rows)

    def _load_font(self, size):
        for path in FONT_CANDIDATES:
            if os.path.exists(path):
                return ImageFont.truetype(path, size)
        return ImageFont.load_default()

    def _mark_dirty(self):
        with self.lock:
            self.dirty = True
            self.last_input = time.time()

    # ------------------------------------------------------------- input
    def feed(self, text):
        text = strip_ansi(text)
        if not text:
            return
        text = text.replace("\r\n", "\n").replace("\r", "\n")
        with self.lock:
            self.lines.extend(text.split("\n"))
        self._mark_dirty()

    def reader_stdin(self, done_event):
        try:
            for line in sys.stdin:
                if self.stop.is_set():
                    return
                self.feed(line)
            self.feed("\n")
        finally:
            done_event.set()

    def reader_fifo(self, path):
        if not os.path.exists(path):
            os.mkfifo(path)
        fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)
        poll = select.poll()
        poll.register(fd, select.POLLIN)
        logging.info("listening on %s", path)
        try:
            while not self.stop.is_set():
                for _fd, _ev in poll.poll(500):
                    data = os.read(_fd, 4096)
                    if data:
                        self.feed(data.decode("utf-8", "replace"))
        finally:
            os.close(fd)

    def poller_tmux(self, secs):
        while not self.stop.is_set():
            if self.stop.wait(secs):
                return
            try:
                pane = os.popen("tmux capture-pane -p 2>/dev/null").read()
                if pane:
                    self.feed(pane)
            except Exception as exc:
                logging.debug("tmux capture failed: %s", exc)

    # ------------------------------------------------------------- shell
    def init_shell(self):
        self.vterm_screen = pyte.Screen(self.cols, self.rows)
        self.vterm_stream = pyte.ByteStream(self.vterm_screen)
        self._first_spawn = True

    def spawn_shell(self):
        master, slave = pty.openpty()
        fcntl.ioctl(slave, termios.TIOCSWINSZ,
                    struct.pack("HHHH", self.rows, self.cols, 0, 0))

        def _child():
            os.setsid()
            fcntl.ioctl(0, termios.TIOCSCTTY, 0)

        env = dict(os.environ, TERM="xterm")
        self.shell_proc = subprocess.Popen(
            ["/bin/bash", "-i"],
            stdin=slave, stdout=slave, stderr=slave,
            preexec_fn=_child, env=env,
            cwd=os.path.expanduser("~"))
        os.close(slave)
        self.shell_master = master
        if self._first_spawn and self.exec_cmd:
            self.shell_write(self.exec_cmd + "\n")
        self._first_spawn = False
        logging.info("spawned bash (pid %d)", self.shell_proc.pid)

    def shell_write(self, text):
        m = self.shell_master
        if m is None:
            return
        try:
            os.write(m, text.encode("utf-8"))
        except OSError as exc:
            logging.debug("shell write failed: %s", exc)

    def reader_shell(self):
        while not self.stop.is_set():
            self.spawn_shell()
            self.vterm_screen.reset()
            self._mark_dirty()
            while not self.stop.is_set():
                try:
                    data = os.read(self.shell_master, 4096)
                except OSError as exc:
                    logging.warning("pty read failed: %s", exc)
                    data = b""
                if not data:
                    break
                logging.debug("pty data: %d bytes", len(data))
                try:
                    self.vterm_stream.feed(data)
                    self._mark_dirty()
                except Exception as exc:
                    logging.warning("vterm feed failed: %r", exc)
            if self.stop.is_set():
                break
            logging.info("shell exited; respawning in 1s")
            try:
                self.shell_proc.wait(timeout=1)
            except Exception:
                pass
            self.stop.wait(1)

    # ---------------------------------------------------------- rendering
    def _layout(self):
        with self.lock:
            snapshot = list(self.lines)
        visual = []
        for line in snapshot:
            for i in range(0, len(line), self.cols):
                visual.append(line[i:i + self.cols])
        return visual[-self.rows:]

    def render(self, title=""):
        if self.vterm_screen is not None:
            return self._render_vterm()
        visual = self._layout()
        img = Image.new("L", (self.epd.width, self.epd.height), 255)
        d = ImageDraw.Draw(img)
        m = self.margin
        y = m
        for line in visual:
            d.text((m, y), line, font=self.font, fill=0)
            y += self.line_h
        if self.footer:
            stamp = time.strftime("%Y-%m-%d %H:%M:%S")
            foot = "%s  %s" % (title, stamp) if title else stamp
            d.text((m, self.epd.height - m - self.descent), foot,
                   font=self.font, fill=0)
        d.rectangle((0, 0, self.epd.width - 1, self.epd.height - 1),
                    outline=0)
        return img.point(lambda p: 0 if p < 128 else 255, mode="1")

    def _render_vterm(self):
        screen = self.vterm_screen
        img = Image.new("L", (self.epd.width, self.epd.height), 255)
        d = ImageDraw.Draw(img)
        m = self.margin
        for y, line in enumerate(screen.display):
            d.text((m, m + y * self.line_h), line, font=self.font, fill=0)
        if not getattr(screen.cursor, "hidden", False):
            cx, cy = screen.cursor.x, screen.cursor.y
            if 0 <= cx < self.cols and 0 <= cy < self.rows:
                x = m + cx * self.advance
                y = m + cy * self.line_h
                d.rectangle((x, y, x + self.advance - 1, y + self.line_h - 1),
                            fill=0)
                d.text((x, y), screen.display[cy][cx], font=self.font, fill=255)
        d.rectangle((0, 0, self.epd.width - 1, self.epd.height - 1),
                    outline=0)
        return img.point(lambda p: 0 if p < 128 else 255, mode="1")

    # ------------------------------------------------------------ refresh
    def _ensure_init(self):
        if not self.initialized:
            logging.info("init")
            self.epd.init()
            self.initialized = True

    def _refresh(self):
        buf = self.epd.getbuffer(self.render())
        big_change = (self.last_buf is not None
                      and self._diff_ratio(self.last_buf, buf) > self.full_threshold)
        if self.partial_count >= self.full_every or big_change:
            logging.info("full refresh (periodic%s)",
                         " / big change" if big_change else "")
            self.epd.init()                # restore full-refresh register/LUT state
            self.initialized = True
            if self.full_clear:
                self.epd.Clear()           # all-white reset pass
            t0 = time.time()
            self.epd.display(buf)
            logging.debug("display took %.1fs", time.time() - t0)
            self.partial_count = 0
        else:
            logging.info("partial refresh")
            self._ensure_init()
            t0 = time.time()
            self._partial_display(buf)
            logging.debug("partial took %.1fs", time.time() - t0)
            self.partial_count += 1
        self.last_buf = buf

    def _diff_ratio(self, a, b):
        if len(a) != len(b):
            return 1.0
        diff = 0
        for x, y in zip(a, b):
            if x != y:
                diff += 1
        return diff / len(a)

    def _partial_display(self, buf):
        # Like the stock display_Partial, but writes OLD RAM (0x26) with the
        # previous frame so the controller drives correct old->new transitions.
        epd = self.epd
        epd.send_command(0x3C)                    # BorderWavefrom
        epd.send_data(0x80)
        epd.send_command(0x21)                    # Display update control
        epd.send_data(0x00)
        epd.send_data(0x00)
        epd.send_command(0x3C)                    # BorderWavefrom
        epd.send_data(0x80)
        epd.send_command(0x44)                    # set X range
        epd.send_data(0x00)
        epd.send_data(0x31)
        epd.send_command(0x45)                    # set Y range
        epd.send_data(0x00)
        epd.send_data(0x00)
        epd.send_data(0x2B)
        epd.send_data(0x01)
        epd.send_command(0x4E)                    # set X counter
        epd.send_data(0x00)
        epd.send_command(0x4F)                    # set Y counter
        epd.send_data(0x00)
        epd.send_data(0x00)
        if self.last_buf is not None:
            epd.send_command(0x26)                # OLD RAM = previous frame
            epd.send_data2(self.last_buf)
        epd.send_command(0x24)                    # NEW RAM = current frame
        epd.send_data2(buf)
        epd.TurnOnDisplay_Partial()

    def power_off(self):
        if self.initialized:
            try:
                logging.info("sleep")
                self.epd.sleep()
            except Exception as exc:
                logging.debug("sleep failed: %s", exc)
            self.initialized = False
            self.partial_count = self.full_every  # wake with a full refresh

    def close_shell(self):
        if self.shell_proc is not None:
            try:
                self.shell_proc.terminate()
            except Exception:
                pass
            self.shell_proc = None
        if self.shell_master is not None:
            try:
                os.close(self.shell_master)
            except OSError:
                pass
            self.shell_master = None


def main():
    ap = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--pipe", nargs="?", const="/tmp/epterm", metavar="PATH",
                    help="listen on a named pipe (default /tmp/epterm)")
    ap.add_argument("--tmux", nargs="?", const=5.0, type=float, metavar="SECS",
                    help="mirror the active tmux pane every SECS seconds")
    ap.add_argument("--shell", nargs="?", const=True, default=None,
                    metavar="DEVICE",
                    help="run an interactive bash shell driven by a USB "
                         "keyboard (optionally specify /dev/input/eventN)")
    ap.add_argument("--grab", action="store_true",
                    help="grab the keyboard exclusively (only with --shell)")
    ap.add_argument("--exec", default=None, metavar="CMD",
                    help="run CMD in the shell when it starts")
    ap.add_argument("--title", default="epterm")
    ap.add_argument("--size", type=int, default=12,
                    help="monospace font size in px")
    ap.add_argument("--rows", type=int, default=None)
    ap.add_argument("--cols", type=int, default=None)
    ap.add_argument("--interval", type=float, default=1.0,
                    help="minimum seconds between refreshes")
    ap.add_argument("--full-every", type=int, default=5,
                    help="full refresh every N partial refreshes")
    ap.add_argument("--idle", type=float, default=60.0,
                    help="power off the panel after this many idle seconds")
    ap.add_argument("--full-clear", action="store_true",
                    help="do an all-white Clear() pass before each full refresh")
    ap.add_argument("--clear-only", action="store_true",
                    help="blank the panel (init + Clear + sleep) and exit; "
                         "used by the systemd ExecStopPost fallback")
    ap.add_argument("-v", "--verbose", action="store_true")
    args = ap.parse_args()

    logging.basicConfig(
        level=logging.DEBUG if args.verbose else logging.INFO,
        format="%(asctime)s %(levelname)s %(message)s")

    if args.clear_only:
        try:
            epd = epd4in2_V2.EPD()
            logging.info("clear-only: init")
            epd.init()
            logging.info("clear-only: Clear")
            epd.Clear()
            logging.info("clear-only: sleep")
            epd.sleep()
        except Exception as exc:
            logging.error("clear-only failed: %s", exc)
        return

    shell_mode = args.shell is not None
    term = EPaperTerm(size=args.size, rows=args.rows, cols=args.cols,
                      interval=args.interval, full_every=args.full_every,
                      idle_timeout=args.idle, footer=not shell_mode,
                      exec_cmd=args.exec, full_clear=args.full_clear)
    if shell_mode:
        term.init_shell()

    def shutdown(_sig, _frame):
        term.stop.set()
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    signal.signal(signal.SIGHUP, shutdown)
    signal.signal(signal.SIGQUIT, shutdown)

    # Live modes (shell/pipe/tmux) blank the panel on exit; one-shot stdin
    # (cmd | epterm) keeps its content displayed on the panel.
    clear_on_exit = (shell_mode
                     or args.pipe is not None
                     or args.tmux is not None)

    threads = []
    if shell_mode:
        kb = Keyboard(term.shell_write,
                      device=args.shell if isinstance(args.shell, str) else None,
                      grab=args.grab)
        threads.append((threading.Thread(target=kb.run, daemon=True), None))
        threads.append((threading.Thread(
            target=term.reader_shell, daemon=True), None))
    else:
        live = args.pipe is not None or args.tmux is not None
        if live:
            term.feed("epterm ready - waiting for input...")
        if not live or not sys.stdin.isatty():
            done = threading.Event()
            threads.append((threading.Thread(
                target=term.reader_stdin, args=(done,), daemon=True), done))
        if args.pipe:
            threads.append((threading.Thread(
                target=term.reader_fifo, args=(args.pipe,), daemon=True), None))
        if args.tmux:
            threads.append((threading.Thread(
                target=term.poller_tmux, args=(args.tmux,), daemon=True), None))

    for t, _ in threads:
        t.start()

    last_display = 0.0
    try:
        while not term.stop.is_set():
            now = time.time()
            with term.lock:
                dirty = term.dirty

            if dirty and (now - last_display) >= term.interval:
                with term.lock:
                    term.dirty = False      # clear before the (blocking) refresh
                term._refresh()             # updates arriving during the refresh
                last_display = now          # re-set the flag and get caught next pass
            elif (not dirty and term.initialized
                  and (now - term.last_input) >= term.idle_timeout):
                logging.info("idle - powering off panel")
                term.partial_count = term.full_every
                term._refresh()          # final clean full refresh
                term.power_off()
                last_display = now

            if not shell_mode:
                all_done = all(
                    e is not None and e.is_set() for _, e in threads)
                if all_done and not dirty:
                    break
            time.sleep(0.05)
    finally:
        term.stop.set()
        for t, _ in threads:
            t.join(timeout=2)
        term.close_shell()
        if clear_on_exit:
            try:
                term.epd.init()          # re-power/reopen SPI even if asleep
                term.epd.Clear()         # blank the panel
                term.initialized = True
            except Exception as exc:
                logging.debug("final clear failed: %s", exc)
        term.power_off()


if __name__ == "__main__":
    main()